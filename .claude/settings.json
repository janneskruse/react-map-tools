{
  "permissions": {
    "allow": [
      "Bash(bd:*)",
      "Bash(bv --robot-help:*)",
      "Bash(bv --robot-insights:*)",
      "Bash(bv --robot-plan:*)",
      "Bash(bv --robot-priority:*)",
      "Bash(bv --robot-recipes:*)",
      "Bash(bv --robot-diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(git ls-tree:*)",
      "Bash(git check-ignore:*)",
      "Bash(git lfs:*)",
      "Bash(git branch:*)",
      "Bash(git -C:*)",
      "Bash(gh:*)",
      "Bash(yarn:*)",
      "Bash(npx:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(uv:*)",
      "Bash(dagger:*)",
      "Bash(ast-grep:*)",
      "Bash(sg:*)",
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(file:*)",
      "Bash(grep:*)",
      "Bash(echo:*)",
      "Bash(timeout:*)",
      "Bash(curl:*)",
      "Bash(comm:*)",
      "Bash(tee:*)",
      "Bash(brew:*)",
      "WebSearch",
      "WebFetch(domain:localhost)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "mcp__ide__getDiagnostics",
      "Skill(ast-grep:*)",
      "Skill(brainstorm)",
      "Skill(review)",
      "Skill(ship)",
      "Skill(design)",
      "Skill(worktree)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(rm:*)",
      "mcp__mapular-admin__list_tenants",
      "mcp__mapular-admin__get_user_context",
      "mcp__mapular-admin__list_mapbooks",
      "mcp__mapular-admin__inspect_mapbook",
      "mcp__mapular-admin__list_series",
      "mcp__mapular-admin__check_auth"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ask-on-protected-skill-edit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ask-on-protected-command.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-compound-cd.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "astral@astral-sh": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins"
      }
    }
  }
}
